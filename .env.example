# ── Database (Drizzle + node-postgres) ────────────────────────────────
# Local Docker Compose default (see docker-compose.yml). Swap for Neon later.
DATABASE_URL="postgresql://autoshop:autoshop@localhost:5432/autoshop"

# ── better-auth ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google OAuth ──────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Upstash Redis (rate limiting) ─────────────────────────────────────
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
